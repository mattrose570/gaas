@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    
    <div style="display: flex; gap: 10px;">
        <a asp-controller="Auth" asp-action="Login"
           class="btn btn-primary">Login</a>

        <a asp-controller="Auth" asp-action="SignUp"
           class="btn btn-secondary">Sign Up</a>
    </div>

</div>

<div>
    <form asp-controller="GaaS"
          asp-action="GetGuid"
          method="post"
          onsubmit="getGuid(Event)">

        <button type="submit">Generate and save GUID</button>
    </form>
    
    <p id="guidResult"></p>
</div>

@section Scripts {
    <script>
        async function getGuid(event) {
            // Stop the form from navigating to another page.
            event.preventDefault();

            const form = event.currentTarget;
            const button = form.querySelector("button");
            const output = document.getElementById("guidResult");

            button.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form)
                });

                if (!response.ok) {
                    throw new Error("Request failed");
                }

                const guid = await response.json();
                output.textContent = `Saved GUID: ${guid}`;
            } catch {
                output.textContent = "Could not confirm the GUID was saved.";
            } finally {
                button.disabled = false;
            }
        }
    </script>
}